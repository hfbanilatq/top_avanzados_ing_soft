			"name": "Get Mars Rover Photos",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Body matches string\", function () {\r",
							"    pm.expect(pm.response.text()).to.include(\"photos\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{BASE_URL}}/{{API_EARTH_PHOTOS}}?api_key={{API_KEY}}&earth_date=2022-08-30",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"{{API_EARTH_PHOTOS}}"
					],
					"query": [
						{
							"key": "api_key",
							"value": "{{API_KEY}}"
						},
						{
							"key": "earth_date",
							"value": "2022-08-30"
						}
					]
				}
			},
